AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b

# Optional alternative provider:
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_api_key_here
# OPENAI_MODEL=gpt-4.1-mini

# Production-only values are configured in the hosting dashboard, never in this file:
# MANAGER_DEFAULT_PASSWORD=choose-a-long-unique-password
# STAFF_DEFAULT_PASSWORD=choose-a-different-long-unique-password
# STOCKSENSE_DATA_DIR=/var/data
